<Window x:Class="CS077.ContractVerification.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VOID RUNNERS — Contract Verification (Jane // Ashwake)"
        Width="1060" Height="760" MinWidth="760" MinHeight="560"
        Background="#071015" Foreground="#EEF9FC">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEF9FC" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Foreground="#61DDF4" FontSize="12" Text="CS077 // VOID RUNNERS // ASHWAKE RECORDS // MARS — THE OSSUARY BELT" />
                <TextBlock x:Name="MissionTitle" Margin="0,10,0,8" FontSize="32" Text="Verify the Dark Veil Medical Rescue Warrant" />
                <TextBlock Foreground="#B9CBD1" FontSize="15" Text="Horror // Martian Wasteland — Verify every incoming distress and supply contract before deploying scarce medical aid." />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="20" BorderBrush="#24505B" BorderThickness="1" Background="#0A1A20">
                    <StackPanel>
                        <Image x:Name="MissionImage" Source="Assets/CS077-Mission-Reference.png"
                               Height="220" Stretch="UniformToFill"
                               AutomationProperties.Name="Portrait and mission illustration of Jane, Field Medic on Mars." />
                        <TextBlock Margin="0,8,0,18" Foreground="#B9CBD1" FontSize="12" Text="Jane — Field Medic (Broken Reach medicine and seed courier)" />
                        <TextBlock x:Name="RunnerName" Foreground="#F1AC6C" FontSize="24" Text="Jane" />
                        <TextBlock x:Name="RunnerRole" Margin="0,6,0,18" FontSize="14" Text="Role: Field Medic (Calm, Fast-Paced, Organized) | Strength: Repairs damaged equipment | Limitation: Replacement parts and power are scarce" />
                        <TextBlock Foreground="#61DDF4" Text="DISCOVERY" />
                        <TextBlock x:Name="DiscoveryText" Margin="0,6,0,18" FontSize="15" Text="In the scorching dirt and rock wasteland of Mars, Jane intercepts a warrant claiming the trapped Dark Veil crew needs urgent medical aid—yet the isolated sector makes incoming signals unreliable." />
                        <TextBlock Foreground="#61DDF4" Text="WHAT IS AT STAKE" />
                        <TextBlock x:Name="StoryConsequence" Margin="0,6,0,0" FontSize="15" Text="The injured Dark Veil crew depends on medical supplies and perimeter defense, but trusting a spoofed signal risks leading Jane into a creature ambush and losing their base." />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Padding="20" BorderBrush="#24505B" BorderThickness="1" Background="#0A1A20">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,20" Foreground="#61DDF4" Text="EVIDENCE INPUTS" />
                            <CheckBox x:Name="TimestampConflictCheckBox" Content="The timestamps conflict" />
                            <CheckBox x:Name="IdentityConfirmedCheckBox" Content="The identity is confirmed" />
                            <CheckBox x:Name="SourceVerifiedCheckBox" Content="The evidence source is verified" />
                            <Button Padding="18,12" HorizontalAlignment="Left" Background="#0D5362" Foreground="White"
                                    FontSize="15" FontWeight="SemiBold" Click="EvaluateContractButton_Click" Content="Evaluate Contract" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,20,0,0" Padding="20" BorderBrush="#B77B42" BorderThickness="1" Background="#1B130C">
                        <StackPanel>
                            <TextBlock Foreground="#E8A45D" Text="CURRENT VERDICT" />
                            <TextBlock x:Name="VerdictTextBlock" Margin="0,8,0,12" FontSize="38" Text="NOT TESTED" />
                            <TextBlock x:Name="ExplanationTextBlock" Foreground="#D6C4B0" FontSize="15" Text="Choose evidence states, then evaluate the contract." />
                            <TextBlock Margin="0,18,0,0" Foreground="#B9CBD1" FontSize="12" Text="CLEAR means the record passed these checks. It does not establish Orra Quill's guilt." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>