<Window x:Class="StoryProduct.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoryProduct"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

	<StackPanel Margin="24">

		<TextBlock Text="My story checklist"
                   FontSize="26" />

		<Label Content="_Name"
               Target="{Binding ElementName=NameInput}" />

		<TextBox x:Name="NameInput" />

		<Button Click="Build_Click"
                Margin="0,16,0,12"
                Padding="12"
                AutomationProperties.Name="Build my checklist">

			<StackPanel Orientation="Horizontal">

				<Image Source="Assets/Images/action.png"
                       Width="28"
                       Height="28"
                       Margin="0,0,10,0" />

				<TextBlock Text="Build my checklist"
                           VerticalAlignment="Center" />

			</StackPanel>

		</Button>

		<CheckBox x:Name="SoundEnabled"
                  Content="Enable sound" />

		<Button Content="Preview sound"
                Click="PreviewSound_Click"
                Padding="8" />

		<TextBlock x:Name="ResultText"
                   Text="Ready."
                   TextWrapping="Wrap" />

	</StackPanel>

</Window>