<Window x:Class="MusicReferenceHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hello Kitty's Cute Jukebox" 
        Width="480" Height="840" 
        MinWidth="420" MinHeight="750" 
        Background="#FFF0F5" Foreground="#5C3A4D" 
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Soft Pink Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFD1DC"/>
            <Setter Property="Foreground" Value="#6B304B"/>
            <Setter Property="BorderBrush" Value="#FFB6C1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB6C1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF91A4"/>
                                <Setter Property="Foreground" Value="#4A1E31"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF91A4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hot Pink Accent Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF69B4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF1493"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1493"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C71585"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#5C3A4D"/>
            <Setter Property="BorderBrush" Value="#FFB6C1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionBrush" Value="#FF69B4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF69B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#5C3A4D"/>
            <Setter Property="BorderBrush" Value="#FFB6C1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border" 
                                            Background="Transparent" 
                                            CornerRadius="8" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFF0F5"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFD1DC"/>
                                            <Setter Property="Foreground" Value="#5C3A4D"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fixed Clean Header Banner -->
        <Border Grid.Row="0" Background="#FFE4E1" BorderBrush="#FFB6C1" BorderThickness="1.5" CornerRadius="14" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🎀 HELLO KITTY JUKEBOX" Foreground="#FF1493" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Sweet Melodies &amp; Diary" FontSize="15" FontWeight="Bold" Foreground="#5C3A4D" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Image_Click" ToolTip="Change cover artwork">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="imgButton" Width="12" Height="12" Margin="0,0,3,0"/>
                            <TextBlock Text="Art" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Open" Click="Open_Click"/>
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,8">
                <!-- Media Display Card -->
                <Border Background="#FFFFFF" BorderBrush="#FFB6C1" BorderThickness="1.5" CornerRadius="18" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#FFF0F5" CornerRadius="14" BorderBrush="#FFD1DC" BorderThickness="1" Height="220" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="imgArtwork" Source="Assets/Images/Hellokitty.jpg" Stretch="UniformToFill"/>
                                <Border Background="#80FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" CornerRadius="12" Padding="8,4" Margin="8">
                                    <TextBlock Text="♡ favorite" Foreground="#FF1493" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="txtNowPlaying" Text="No track playing ♡" Foreground="#5C3A4D" FontSize="13" FontWeight="Bold" Margin="0,10,0,6" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <!-- Hidden Media Player Core -->
                        <MediaElement x:Name="mediaPlayer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" LoadedBehavior="Manual" UnloadedBehavior="Stop" Volume="0.5" MediaOpened="Media_Opened" MediaFailed="Media_Failed" MediaEnded="Media_Ended"/>

                        <!-- Progress Slider & Timers -->
                        <Slider x:Name="progressSlider" Margin="0,4,0,2"
                                PreviewMouseLeftButtonDown="ProgressSlider_DragStarted" 
                                PreviewMouseLeftButtonUp="ProgressSlider_DragCompleted" 
                                ValueChanged="ProgressSlider_ValueChanged"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="lblCurrentTime" Text="00:00" Foreground="#8A5A73" FontSize="11" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="lblTotalTime" Text="00:00" Foreground="#8A5A73" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Controls and Volume -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel VerticalAlignment="Center">
                                <Button Content="▶ Play" Click="Play_Click"/>
                                <Button Content="⏸ Pause" Click="Pause_Click"/>
                                <Button Content="⏹ Stop" Click="Stop_Click"/>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔊" Foreground="#8A5A73" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="volumeSlider" Width="65" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Playlist Deck -->
                <Border Background="#FFFFFF" BorderBrush="#FFB6C1" BorderThickness="1.5" CornerRadius="18" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="♡ Playlist Tracks" FontSize="13" FontWeight="Bold" Foreground="#5C3A4D" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource AccentButton}" Content="[+ Add Tracks]" Click="Load_Click" HorizontalAlignment="Right" Margin="0"/>
                        </Grid>

                        <ListBox x:Name="lstPlaylist" Height="100" Margin="0,0,0,8" SelectionChanged="LstPlaylist_SelectionChanged"/>

                        <!-- YouTube / Web Link Input Entry -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtLink" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Paste YouTube link here..."/>
                            <Button Grid.Column="1" Content="Add Link" Click="AddLink_Click" Margin="0"/>
                        </Grid>

                        <ListBox x:Name="lstLinks" Height="60" Margin="0,0,0,8"/>

                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="🔗 Open Web" Click="OpenLink_Click"/>
                            <Button Content="🗑️ Clear Playlist" Click="ClearPlaylist_Click" Margin="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Notes Deck -->
                <Border Background="#FFFFFF" BorderBrush="#FFB6C1" BorderThickness="1.5" CornerRadius="18" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🎀 Notes &amp; Diary" FontSize="13" FontWeight="Bold" Foreground="#5C3A4D" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtNotes" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource AccentButton}" Content="save ♡" Click="Save_Click" HorizontalAlignment="Right" Margin="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#FFE4E1" BorderBrush="#FFB6C1" BorderThickness="1.5" CornerRadius="10" Padding="10,6" Margin="0,8,0,0">
            <TextBlock x:Name="txtStatus" Text="Ready. Pick your favorite moment! Curated for pure cuteness ♡" Foreground="#5C3A4D" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>