<Window x:Class="DispatchBoard.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dispatch Board | Training tasks" Width="1000" Height="680"
 MinWidth="780" MinHeight="540" Background="#071B25"
 Foreground="#E5F3F1">
	<Grid Margin="28">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<StackPanel>
			<TextBlock Text="CLIENT JOB 9A / TRAINING DISPATCH"
			 Foreground="#EEC77D" FontSize="13"/>
			<TextBlock Text="What still needs doing?"
			 FontSize="32" Margin="0,8,0,6"/>
			<TextBlock Text="Read-only practice data. Not real crew tasks."
			 Margin="0,0,0,20"/>
		</StackPanel>
		<WrapPanel Grid.Row="1" Margin="0,0,0,18">
			<Button x:Name="btnLoad" Content="Load online"/>
			<Button x:Name="btnOpen" Content="Open saved JSON"/>
			<Button x:Name="btnFilter" Content="Open only / All"/>
			<Button x:Name="btnExport" Content="Save visible summary"/>
		</WrapPanel>
		<ListView x:Name="lstTasks" Grid.Row="2"
   Background="#F1F6F4" Foreground="#152E39">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="ID" Width="60"
					 DisplayMemberBinding="{Binding Id}"/>
					<GridViewColumn Header="Training task" Width="610"
					 DisplayMemberBinding="{Binding Title}"/>
					<GridViewColumn Header="Completed?" Width="110"
					 DisplayMemberBinding="{Binding Completed}"/>
				</GridView>
			</ListView.View>
		</ListView>
		<TextBlock x:Name="txtStatus" Grid.Row="3"
		   Text="Ready. Load online or open a saved JSON file."
		   Margin="0,16,0,0" Foreground="#B9E5E5"/>
		
	</Grid>

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Padding" Value="14,9"/>
			<Setter Property="Margin" Value="0,0,8,0"/>
			<Setter Property="Background" Value="#B9E5E5"/>
			<Setter Property="Foreground" Value="#09212B"/>
		</Style>
		<Style TargetType="TextBlock">
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
	</Window.Resources>
</Window>